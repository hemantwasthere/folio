NEXT_PUBLIC_POSTHOG_KEY=<ph_project_api_key>
NEXT_PUBLIC_POSTHOG_HOST=<ph_instance_address>

# Optional. The code:work section reads your pinned repos without any auth, so
# this is not required. Setting it only raises GitHub's API rate limit from
# 60 to 5000 requests/hour, which matters if the site gets heavy traffic.
# A classic PAT with no scopes (public data only) is enough.
GITHUB_TOKEN=<github_personal_access_token>
