NEXT_PUBLIC_POSTHOG_KEY=<ph_project_api_key>
NEXT_PUBLIC_POSTHOG_HOST=<ph_instance_address>

# Backs the sign:wall section. Without these the wall renders a "not connected"
# notice and the rest of the site is unaffected. Run supabase/signatures.sql in
# the Supabase SQL editor first. The anon key is meant to be public — every
# write is gated by row level security.
NEXT_PUBLIC_SUPABASE_URL=<https://xxxx.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase_anon_key>

# Optional. Where Google should send people back to after login. Defaults to
# whatever origin the browser is on, which is right for both localhost and prod;
# set it only if you need to pin the redirect to the canonical domain.
NEXT_PUBLIC_SITE_URL=https://hemant.lol

# Optional. The code:work section reads your pinned repos without any auth, so
# this is not required. Setting it only raises GitHub's API rate limit from
# 60 to 5000 requests/hour, which matters if the site gets heavy traffic.
# A classic PAT with no scopes (public data only) is enough.
GITHUB_TOKEN=<github_personal_access_token>
